---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFab from '../components/WhatsAppFab.astro';
import { site, url } from '../lib/content';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { title, description = site.description, image = '/img/fotos/david-janina.webp' } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : `${site.name} · HYROX Box & Coaching en Lanzarote`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(url(image), Astro.site);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SportsActivityLocation',
  name: site.name,
  description: site.description,
  url: new URL(url('/'), Astro.site).toString(),
  email: site.contact.email,
  telephone: site.contact.phone,
  logo: new URL(url(site.logo), Astro.site).toString(),
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.contact.address.street,
    addressLocality: site.contact.address.city,
    addressRegion: site.contact.address.region,
    postalCode: site.contact.address.zip,
    addressCountry: 'ES',
  },
  sameAs: site.social.map((s) => s.url),
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#070909" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:rounded-full focus:bg-brand focus:px-4 focus:py-2 focus:text-ink">
      Saltar al contenido
    </a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <WhatsAppFab />
    <script>
      import { initReveal } from '../scripts/reveal';
      initReveal();
    </script>
  </body>
</html>
