---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Photo from '../../components/Photo.astro';
import { whatsappUrl, useI18n } from '../../lib/content';
import { localeStaticPaths } from '../../i18n/config';

export const getStaticPaths = localeStaticPaths;

const { services, t } = useI18n(Astro.url);
const sp = t.servicesPage;
---

<Base title={sp.title} description={sp.description}>
  <PageHero
    kicker={sp.kicker}
    title={sp.title}
    text={sp.text}
    image="/img/fotos/ciclismo"
  >
    <nav aria-label={sp.title} class="mt-10 flex flex-wrap gap-2">
      {services.map((s) => <a href={`#${s.id}`} class="rounded-full border border-white/15 px-4 py-2 text-sm font-semibold hover:border-brand hover:text-brand">{s.title}</a>)}
    </nav>
  </PageHero>

  {
    services.map((s, i) => (
      <section id={s.id} class:list={['py-20 sm:py-28', i % 2 === 1 && 'bg-ink-800']} aria-labelledby={`${s.id}-title`}>
        <div class="container-x grid gap-12 lg:grid-cols-2 lg:gap-20">
          <div class:list={['relative', i % 2 === 1 && 'lg:order-last']} data-reveal>
            <Photo src={s.image} alt={s.title} class="aspect-[4/3] w-full rounded-[2rem] object-cover lg:sticky lg:top-28" />
          </div>
          <div>
            <p class="kicker" data-reveal>{String(i + 1).padStart(2, '0')} / {String(services.length).padStart(2, '0')}</p>
            <h2 id={`${s.id}-title`} class="display mt-4 text-5xl sm:text-6xl" data-reveal>{s.title}</h2>
            <p class="mt-4 text-lg text-bone/75" data-reveal>{s.short}</p>

            <h3 class="mt-10 text-xs font-bold tracking-[0.2em] text-mute uppercase">{sp.includes}</h3>
            <ul class="mt-4 space-y-3">
              {s.includes.map((it) => (
                <li class="flex gap-3 text-bone/85" data-reveal>
                  <span aria-hidden="true" class="mt-2 size-2 shrink-0 rotate-45 bg-brand" />
                  {it}
                </li>
              ))}
            </ul>

            <ul class="mt-10 grid gap-3">
              {s.prices.map((p) => (
                <li class="card flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 p-5" data-reveal>
                  <span class="font-semibold">{p.label}</span>
                  <span class="display text-3xl text-brand">
                    {p.price}
                    <span class="font-sans text-sm text-mute normal-case">{p.period}</span>
                  </span>
                  <span class="w-full text-sm text-mute">{p.note}</span>
                </li>
              ))}
            </ul>
            {s.footnote && <p class="mt-4 text-xs text-mute">{s.footnote}</p>}

            <a href={whatsappUrl(t.whatsapp.service(s.title))} target="_blank" rel="noopener" class="btn-primary mt-8">
              {sp.info}
            </a>
          </div>
        </div>
      </section>
    ))
  }
</Base>
