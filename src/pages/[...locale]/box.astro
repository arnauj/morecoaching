---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { whatsappUrl, useI18n } from '../../lib/content';
import { localeStaticPaths } from '../../i18n/config';

export const getStaticPaths = localeStaticPaths;

const { box, t } = useI18n(Astro.url);
const b = t.boxPage;
---

<Base title={b.title} description={b.description}>
  <PageHero kicker={box.hero.kicker} title={box.hero.title} text={box.hero.text}>
    <p class="mt-8 inline-flex items-center gap-3 rounded-full border border-white/15 px-5 py-2 text-sm text-bone/80">
      <span class="size-2 animate-pulse rounded-full bg-brand"></span>
      {box.location.text}
    </p>
  </PageHero>

  <!-- Equipamiento -->
  <section class="container-x pb-24 sm:pb-32" aria-labelledby="equipo-title">
    <div class="grid gap-12 lg:grid-cols-2">
      <SectionHeading id="equipo-title" kicker={b.equipmentKicker} title={b.equipmentTitle} highlight={b.equipmentHighlight} />
      <ul class="grid gap-3 sm:grid-cols-2">
        {
          box.equipment.map((e, i) => (
            <li class="flex items-center gap-4 rounded-2xl border border-white/8 p-4" data-reveal style={`--d:${i * 50}ms`}>
              <span class="display text-2xl text-brand">{String(i + 1).padStart(2, '0')}</span>
              <span class="font-semibold">{e}</span>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="mt-14 text-center">
      <a href={whatsappUrl(t.whatsapp.default)} target="_blank" rel="noopener" class="btn-primary">{b.info}</a>
    </div>
  </section>
</Base>
