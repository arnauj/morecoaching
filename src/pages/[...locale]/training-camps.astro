---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import Photo from '../../components/Photo.astro';
import { whatsappUrl, useI18n } from '../../lib/content';
import { localeStaticPaths } from '../../i18n/config';

export const getStaticPaths = localeStaticPaths;

const { camps, t } = useI18n(Astro.url);
const c = t.campsPage;
---

<Base title={c.title} description={c.description}>
  <PageHero kicker={c.kicker} title={camps.title} text={camps.subtitle} image={camps.image} />

  <section class="container-x pb-24 sm:pb-32">
    <div class="grid gap-12 lg:grid-cols-2 lg:gap-20">
      <p class="text-xl text-bone/80 sm:text-2xl" data-reveal>{camps.intro}</p>
      <Photo src="/img/fotos/running" alt={c.photoAlt} class="aspect-square w-full rounded-[2rem] object-cover" />
    </div>
  </section>

  <section class="bg-ink-800 py-24 sm:py-32">
    <div class="container-x grid gap-16 lg:grid-cols-2">
      <div>
        <SectionHeading kicker={c.advKicker} title={c.advTitle} highlight={c.advHighlight} />
        <ul class="mt-10 space-y-4">
          {camps.advantages.map((a, i) => (
            <li class="flex gap-4" data-reveal style={`--d:${i * 50}ms`}>
              <span class="display w-8 shrink-0 text-xl text-brand">{String(i + 1).padStart(2, '0')}</span>
              <span class="text-bone/85">{a}</span>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <SectionHeading kicker={c.inclKicker} title={c.inclTitle} highlight={c.inclHighlight} />
        <ul class="mt-10 space-y-4">
          {camps.included.map((a, i) => (
            <li class="flex gap-4" data-reveal style={`--d:${i * 50}ms`}>
              <span aria-hidden="true" class="mt-2 size-2 shrink-0 rotate-45 bg-brand" />
              <span class="text-bone/85">{a}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="container-x py-24 sm:py-32">
    <SectionHeading kicker={c.pricesKicker} title={c.pricesTitle} highlight={c.pricesHighlight} text={camps.pricesNote} align="center" />
    <ul class="mx-auto mt-14 grid max-w-4xl gap-4 sm:grid-cols-3">
      {camps.prices.map((p, i) => (
        <li class:list={['rounded-3xl p-8 text-center', i === 1 ? 'bg-brand text-ink' : 'card']} data-reveal style={`--d:${i * 80}ms`}>
          <p class="display text-7xl">{p.days}</p>
          <p class="text-xs font-bold tracking-[0.2em] uppercase opacity-70">{c.days}</p>
          <p class="display mt-6 text-4xl">{p.price}</p>
        </li>
      ))}
    </ul>

    <h3 class="display mt-24 text-4xl" data-reveal>{c.extras}</h3>
    <ul class="mt-8 grid gap-4 md:grid-cols-3">
      {camps.extras.map((e) => (
        <li class="card flex flex-col p-6" data-reveal>
          <h4 class="text-lg font-bold">{e.title}</h4>
          <p class="mt-2 flex-1 text-sm text-bone/70">{e.text}</p>
          <p class="mt-4 font-semibold text-brand">{e.price}</p>
        </li>
      ))}
    </ul>
    <div class="mt-14 text-center">
      <a href={whatsappUrl(t.whatsapp.camp)} target="_blank" rel="noopener" class="btn-primary">{c.cta}</a>
    </div>
  </section>
</Base>
