---
import Base from '../../layouts/Base.astro';
import { site, useI18n } from '../../lib/content';
import { localeStaticPaths } from '../../i18n/config';

export const getStaticPaths = localeStaticPaths;

const { t } = useI18n(Astro.url);
const pp = t.privacyPage;
---

<Base title={pp.metaTitle}>
  <article class="container-x max-w-3xl pt-36 pb-24 sm:pt-44">
    <h1 class="display text-6xl sm:text-7xl">{pp.title}</h1>
    <div class="mt-10 space-y-6 text-bone/80">
      {pp.paragraphs(site.legal.owner, site.contact.email).map((text) => <p>{text}</p>)}
      <p class="text-sm text-mute">{pp.draft}</p>
    </div>
  </article>
</Base>
