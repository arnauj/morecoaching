---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ContactBlock from '../components/ContactBlock.astro';
import { site, url } from '../lib/content';

const interests = ['Clase de prueba en el box', 'HYROX Race Prep 1:1', 'Coaching de triatlón', 'Coaching de running', 'Nutrición deportiva', 'Diagnóstico del rendimiento', 'Training Camp', 'Otro'];
const inputCls =
  'mt-2 w-full rounded-2xl border border-white/12 bg-ink-800 px-4 py-3.5 text-bone placeholder:text-mute/70 transition focus:border-brand focus:outline-none focus:ring-2 focus:ring-brand/30';
---

<Base title="Contacto" description="Contacta con More Coaching: primera clase gratis en nuestro box HYROX de Lanzarote, coaching online y training camps.">
  <PageHero kicker="Contacto" title="Hablemos" text="Primera clase gratis y sin compromiso. Cuéntanos tu objetivo y te respondemos en menos de 24 h." />

  <section class="container-x pb-24 sm:pb-32">
    <div class="grid gap-16 lg:grid-cols-[1.3fr_1fr]">
      <form
        id="contact-form"
        action={`mailto:${site.contact.email}`}
        method="post"
        enctype="text/plain"
        class="card space-y-6 p-6 sm:p-10"
        data-reveal
        data-email={site.contact.email}
        data-whatsapp={site.contact.whatsapp}
      >
        <div class="grid gap-6 sm:grid-cols-2">
          <label class="block text-sm font-semibold">
            Nombre <span class="text-brand">*</span>
            <input name="nombre" required autocomplete="name" class={inputCls} placeholder="Tu nombre" />
          </label>
          <label class="block text-sm font-semibold">
            Email <span class="text-brand">*</span>
            <input name="email" type="email" required autocomplete="email" class={inputCls} placeholder="tu@email.com" />
          </label>
        </div>
        <label class="block text-sm font-semibold">
          Teléfono
          <input name="telefono" type="tel" autocomplete="tel" class={inputCls} placeholder="+34 ..." />
        </label>
        <fieldset>
          <legend class="text-sm font-semibold">Me interesa</legend>
          <div class="mt-3 flex flex-wrap gap-2">
            {
              interests.map((it, i) => (
                <label class="cursor-pointer">
                  <input type="radio" name="interes" value={it} class="peer sr-only" checked={i === 0} />
                  <span class="block rounded-full border border-white/12 px-4 py-2 text-sm transition peer-checked:border-brand peer-checked:bg-brand peer-checked:text-ink peer-focus-visible:ring-2 peer-focus-visible:ring-brand hover:border-brand">
                    {it}
                  </span>
                </label>
              ))
            }
          </div>
        </fieldset>
        <label class="block text-sm font-semibold">
          Mensaje <span class="text-brand">*</span>
          <textarea name="mensaje" required rows="5" class={inputCls} placeholder="Cuéntanos tu objetivo, tu nivel actual y disponibilidad"></textarea>
        </label>
        <label class="flex items-start gap-3 text-sm text-bone/70">
          <input type="checkbox" name="privacidad" required class="mt-1 size-4 accent-[var(--color-brand)]" />
          <span>He leído y acepto la <a href={url('/privacidad')} class="text-brand underline">política de privacidad</a>.</span>
        </label>
        <div class="flex flex-col gap-3 sm:flex-row">
          <button type="submit" name="via" value="whatsapp" class="btn-primary">Enviar por WhatsApp</button>
          <button type="submit" name="via" value="email" class="btn-ghost">Enviar por email</button>
        </div>
        <p class="text-xs text-mute">Al enviar se abrirá WhatsApp o tu app de correo con el mensaje ya escrito.</p>
      </form>

      <aside class="space-y-10">
        <ContactBlock />
        <div data-reveal>
          <h2 class="text-xs font-bold tracking-[0.2em] text-mute uppercase">Redes</h2>
          <ul class="mt-4 flex flex-wrap gap-2">
            {site.social.map((s) => (
              <li><a href={s.url} target="_blank" rel="noopener" class="block rounded-full border border-white/12 px-4 py-2 text-sm hover:border-brand hover:text-brand">{s.handle}</a></li>
            ))}
          </ul>
        </div>
      </aside>
    </div>
  </section>
</Base>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const submitter = (e as SubmitEvent).submitter as HTMLButtonElement | null;
    const data = new FormData(form);
    const get = (k: string) => String(data.get(k) ?? '').trim();
    const body = [
      `Nombre: ${get('nombre')}`,
      `Email: ${get('email')}`,
      get('telefono') ? `Teléfono: ${get('telefono')}` : '',
      `Interés: ${get('interes')}`,
    ]
      .filter(Boolean)
      .join('\n') + `\n\n${get('mensaje')}`;

    if (submitter?.value === 'email') {
      const subject = `Web · ${get('interes')} · ${get('nombre')}`;
      window.location.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    } else {
      window.open(`https://wa.me/${form.dataset.whatsapp}?text=${encodeURIComponent(body)}`, '_blank', 'noopener');
    }
  });
</script>
