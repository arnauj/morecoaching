---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import StationsGrid from '../components/StationsGrid.astro';
import Ticker from '../components/Ticker.astro';
import { hyrox, url } from '../lib/content';

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: hyrox.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<Base title="Qué es HYROX" description="HYROX explicado: 8 km de carrera y 8 estaciones funcionales. Formato, pesos, categorías y cómo prepararte en nuestro box de Lanzarote.">
  <PageHero kicker={hyrox.intro.kicker} title="HYROX" text={hyrox.intro.text[0]} image="/img/fotos/running">
    <div class="mt-10 flex flex-wrap gap-3">
      <a href="#estaciones" class="btn-primary">Ver las 8 estaciones</a>
      <a href={url('/box')} class="btn-ghost">Entrena en el box</a>
    </div>
  </PageHero>

  <Ticker items={['Run 1 km', 'Work', 'Repeat × 8']} />

  <section class="container-x py-24 sm:py-32">
    <div class="grid gap-12 lg:grid-cols-2 lg:gap-20">
      <SectionHeading kicker="El formato" title="Una carrera. Ocho batallas." highlight="Ocho" />
      <div class="space-y-5 text-lg text-bone/75" data-reveal>
        {hyrox.intro.text.map((p) => <p>{p}</p>)}
      </div>
    </div>
    <dl class="mt-16 grid grid-cols-2 gap-4 lg:grid-cols-4">
      {
        hyrox.stats.map((s, i) => (
          <div class="card flex flex-col p-6" data-reveal style={`--d:${i * 80}ms`}>
            <dt class="text-sm text-mute">{s.label}</dt>
            <dd class="display order-first text-6xl text-brand">{s.value}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section id="estaciones" class="container-x pb-24 sm:pb-32" aria-labelledby="st-title">
    <div class="mb-12">
      <SectionHeading id="st-title" kicker="El recorrido" title="Estaciones y pesos" highlight="pesos" text={hyrox.weightsNote} />
    </div>
    <StationsGrid showWeights />
  </section>

  <section class="bg-ink-800 py-24 sm:py-32" aria-labelledby="div-title">
    <div class="container-x">
      <SectionHeading id="div-title" kicker="Categorías" title="Elige tu batalla" highlight="batalla" />
      <ul class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          hyrox.divisions.map((d, i) => (
            <li class="card group p-8 transition hover:border-brand/60" data-reveal style={`--d:${i * 80}ms`}>
              <h3 class="display text-4xl transition group-hover:text-brand">{d.name}</h3>
              <p class="mt-4 text-bone/70">{d.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="container-x py-24 sm:py-32" aria-labelledby="faq-title">
    <div class="grid gap-12 lg:grid-cols-[1fr_1.5fr]">
      <SectionHeading id="faq-title" kicker="Preguntas frecuentes" title="Dudas antes de empezar" highlight="empezar" />
      <div class="divide-y divide-white/8 border-y border-white/8">
        {
          hyrox.faq.map((f) => (
            <details class="group py-6" data-reveal>
              <summary class="flex cursor-pointer list-none items-center justify-between gap-6 text-lg font-semibold [&::-webkit-details-marker]:hidden">
                {f.q}
                <span aria-hidden="true" class="grid size-9 shrink-0 place-items-center rounded-full border border-white/15 text-brand transition group-open:rotate-45">+</span>
              </summary>
              <p class="mt-4 pr-12 text-bone/70">{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
</Base>
