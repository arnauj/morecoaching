---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Photo from '../components/Photo.astro';
import { team } from '../lib/content';
---

<Base title="Quiénes somos" description="David y Janina Morales: coaches de resistencia, nutrición y HYROX en Lanzarote.">
  <PageHero kicker="Quiénes somos" title="David & Janina" text={team.intro} />

  <section class="container-x pb-12">
    <div class="relative" data-reveal>
      <Photo src={team.photo} alt="David y Janina Morales en la costa de Lanzarote" sizes="100vw" class="aspect-[16/10] w-full rounded-[2rem] object-cover object-top sm:aspect-[21/9]" />
    </div>
    <ul class="mt-12 grid gap-4 md:grid-cols-3">
      {team.values.map((v, i) => (
        <li class="card p-8" data-reveal style={`--d:${i * 80}ms`}>
          <h2 class="display text-3xl text-brand">{v.title}</h2>
          <p class="mt-3 text-bone/75">{v.text}</p>
        </li>
      ))}
    </ul>
  </section>

  {
    team.members.map((m, i) => (
      <section class="py-20 sm:py-28" aria-labelledby={`m-${i}`}>
        <div class="container-x grid gap-12 lg:grid-cols-[1fr_1.4fr] lg:gap-20">
          <div class:list={[i % 2 === 1 && 'lg:order-last']}>
            <div class="lg:sticky lg:top-28" data-reveal>
              <Photo src={m.image} alt={m.name} class="aspect-[4/5] w-full rounded-[2rem] object-cover" />
              <h3 class="mt-8 text-xs font-bold tracking-[0.2em] text-mute uppercase">Formación</h3>
              <ul class="mt-4 flex flex-wrap gap-2">
                {m.credentials.map((c) => (
                  <li class="rounded-full border border-white/12 px-3 py-1.5 text-xs text-bone/85">{c}</li>
                ))}
              </ul>
            </div>
          </div>
          <div>
            <p class="kicker" data-reveal>{m.role}</p>
            <h2 id={`m-${i}`} class="display mt-4 text-6xl sm:text-8xl" data-reveal>
              {m.name.split(' ')[0]} <span class="text-outline text-brand">{m.name.split(' ').slice(1).join(' ')}</span>
            </h2>
            <div class="mt-10 space-y-6 text-lg text-bone/80">
              {m.bio.map((p) => <p data-reveal>{p}</p>)}
            </div>
          </div>
        </div>
      </section>
    ))
  }
</Base>
