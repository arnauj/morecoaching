---
import { url } from '../lib/content';

interface Props {
  /** Ruta sin extensión, p. ej. /img/fotos/running */
  src: string;
  alt: string;
  class?: string;
  sizes?: string;
  eager?: boolean;
}
const { src: path, alt, class: cls, sizes = '(min-width: 1024px) 50vw, 100vw', eager = false } = Astro.props;
const src = url(path);
---

<img
  src={`${src}-800.webp`}
  srcset={`${src}-800.webp 800w, ${src}.webp 1600w`}
  sizes={sizes}
  alt={alt}
  width="1600"
  height="1600"
  loading={eager ? 'eager' : 'lazy'}
  decoding="async"
  class={cls}
/>
