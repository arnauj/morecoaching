---
import Logo from './Logo.astro';
import { site, navItems, useI18n } from '../lib/content';
import { locales, localeNames, localize } from '../i18n/config';

const { lang, path: current, t, link } = useI18n(Astro.url);
const nav = navItems.map((n) => ({ label: t.nav[n.key], href: n.href }));
const isActive = (href: string) => href !== '/' && (current === href || current.startsWith(`${href}/`));
const languages = locales.map((l) => ({ code: l, name: localeNames[l], href: localize(l, current === '/404' ? '/' : current) }));
---

<header id="site-header" class="fixed inset-x-0 top-0 z-50 transition-all duration-300 data-[scrolled=true]:bg-ink/85 data-[scrolled=true]:backdrop-blur-xl data-[scrolled=true]:shadow-[0_1px_0_rgba(255,255,255,0.06)] data-[menu=true]:!bg-ink">
  <div class="container-x flex h-18 items-center justify-between gap-4 sm:h-20">
    <a href={link('/')} aria-label={`${site.name} — ${t.nav.homeAria}`} class="shrink-0">
      <Logo class="h-12 sm:h-14" />
    </a>

    <nav aria-label={t.nav.main} class="hidden lg:block">
      <ul class="flex items-center gap-1">
        {
          nav.map((item) => (
            <li>
              <a
                href={link(item.href)}
                aria-current={isActive(item.href) ? 'page' : undefined}
                class="rounded-full px-4 py-2 text-sm font-semibold text-bone/80 transition hover:text-brand aria-[current=page]:text-brand"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <details id="lang-menu" class="group relative">
        <summary
          class="grid h-11 cursor-pointer list-none place-items-center rounded-full border border-white/15 px-3.5 font-mono text-xs font-bold tracking-widest text-bone uppercase transition hover:border-brand hover:text-brand [&::-webkit-details-marker]:hidden"
        >
          <span class="sr-only">{t.nav.language}: </span>{lang}
        </summary>
        <ul class="card absolute right-0 mt-2 w-40 overflow-hidden !bg-ink-800 p-1.5 shadow-2xl">
          {
            languages.map((l) => (
              <li>
                <a
                  href={l.href}
                  hreflang={l.code}
                  lang={l.code}
                  aria-current={l.code === lang ? 'true' : undefined}
                  class="flex items-center justify-between rounded-xl px-3 py-2 text-sm text-bone/80 transition hover:bg-ink-700 hover:text-brand aria-[current=true]:text-brand"
                >
                  {l.name}
                  <span class="font-mono text-xs uppercase opacity-60">{l.code}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </details>
      <a href={link('/contacto')} class="btn-primary hidden !px-5 !py-2.5 sm:inline-flex">{t.nav.freeClass}</a>
      <button
        id="menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="grid size-11 place-items-center rounded-full border border-white/15 lg:hidden"
      >
        <span class="sr-only">{t.nav.openMenu}</span>
        <span class="relative block h-3 w-5" aria-hidden="true">
          <span class="bar absolute top-0 left-0 h-0.5 w-5 bg-bone transition"></span>
          <span class="bar absolute bottom-0 left-0 h-0.5 w-5 bg-bone transition"></span>
        </span>
      </button>
    </div>
  </div>
</header>

<!-- Fuera del <header>: su backdrop-filter haría de bloque contenedor y el menú fixed quedaría recortado -->
<div id="mobile-menu" hidden class="fixed inset-x-0 top-18 bottom-0 z-[45] overflow-y-auto overscroll-contain bg-ink sm:top-20 lg:hidden">
  <nav aria-label={t.nav.mobile} class="container-x flex min-h-full flex-col justify-between gap-10 pt-6 pb-10">
    <ul class="space-y-1">
      {
        [{ label: t.nav.home, href: '/' }, ...nav, { label: t.nav.contact, href: '/contacto' }].map((item, i) => (
          <li class="overflow-hidden">
            <a
              href={link(item.href)}
              style={`--i:${i}`}
              class="menu-link display block py-2 text-5xl text-bone transition hover:text-brand"
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
    <div class="space-y-2 text-sm text-mute">
      <ul class="mb-6 flex gap-2" aria-label={t.nav.language}>
        {
          languages.map((l) => (
            <li>
              <a
                href={l.href}
                hreflang={l.code}
                lang={l.code}
                aria-current={l.code === lang ? 'true' : undefined}
                title={l.name}
                class="block rounded-full border border-white/15 px-4 py-2 font-mono text-xs font-bold tracking-widest uppercase hover:border-brand hover:text-brand aria-[current=true]:border-brand aria-[current=true]:bg-brand aria-[current=true]:text-ink"
              >
                {l.code}
              </a>
            </li>
          ))
        }
      </ul>
      <a href={`mailto:${site.contact.email}`} class="block hover:text-brand">{site.contact.email}</a>
      <a href={`tel:${site.contact.phone.replace(/\s/g, '')}`} class="block hover:text-brand">{site.contact.phone}</a>
    </div>
  </nav>
</div>


<style>
  #mobile-menu:not([hidden]) .menu-link {
    animation: rise 0.6s cubic-bezier(0.2, 0.8, 0.2, 1) both;
    animation-delay: calc(var(--i) * 60ms);
  }
  [aria-expanded='true'] .bar:first-child {
    transform: translateY(5px) rotate(45deg);
  }
  [aria-expanded='true'] .bar:last-child {
    transform: translateY(-5px) rotate(-45deg);
  }
</style>

<script>
  const header = document.getElementById('site-header')!;
  const toggle = document.getElementById('menu-toggle')!;
  const menu = document.getElementById('mobile-menu')!;

  const onScroll = () => header.setAttribute('data-scrolled', String(window.scrollY > 24 || !menu.hidden));
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  const setOpen = (open: boolean) => {
    menu.hidden = !open;
    header.setAttribute('data-menu', String(open));
    toggle.setAttribute('aria-expanded', String(open));
    document.body.style.overflow = open ? 'hidden' : '';
    onScroll();
  };
  toggle.addEventListener('click', () => setOpen(menu.hidden));
  document.addEventListener('keydown', (e) => e.key === 'Escape' && setOpen(false));
  window.matchMedia('(min-width: 1024px)').addEventListener('change', (e) => e.matches && setOpen(false));

  // Cierra el selector de idioma al hacer clic fuera o pulsar Escape.
  const langMenu = document.getElementById('lang-menu') as HTMLDetailsElement;
  document.addEventListener('click', (e) => !langMenu.contains(e.target as Node) && (langMenu.open = false));
  document.addEventListener('keydown', (e) => e.key === 'Escape' && (langMenu.open = false));
</script>
