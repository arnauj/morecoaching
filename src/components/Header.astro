---
import Logo from './Logo.astro';
import { site, url } from '../lib/content';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const home = url('/').replace(/\/$/, '') || '/';
const isActive = (href: string) => {
  const full = url(href);
  return full !== home && (path === full || path.startsWith(`${full}/`));
};
---

<header id="site-header" class="fixed inset-x-0 top-0 z-50 transition-all duration-300 data-[scrolled=true]:bg-ink/85 data-[scrolled=true]:backdrop-blur-xl data-[scrolled=true]:shadow-[0_1px_0_rgba(255,255,255,0.06)] data-[menu=true]:!bg-ink">
  <div class="container-x flex h-18 items-center justify-between gap-4 sm:h-20">
    <a href={url('/')} aria-label={`${site.name} — inicio`} class="shrink-0">
      <Logo class="h-12 sm:h-14" />
    </a>

    <nav aria-label="Principal" class="hidden lg:block">
      <ul class="flex items-center gap-1">
        {
          site.nav.map((item) => (
            <li>
              <a
                href={url(item.href)}
                aria-current={isActive(item.href) ? 'page' : undefined}
                class="rounded-full px-4 py-2 text-sm font-semibold text-bone/80 transition hover:text-brand aria-[current=page]:text-brand"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <a href={url('/contacto')} class="btn-primary hidden !px-5 !py-2.5 sm:inline-flex">Clase gratis</a>
      <button
        id="menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="grid size-11 place-items-center rounded-full border border-white/15 lg:hidden"
      >
        <span class="sr-only">Abrir menú</span>
        <span class="relative block h-3 w-5" aria-hidden="true">
          <span class="bar absolute top-0 left-0 h-0.5 w-5 bg-bone transition"></span>
          <span class="bar absolute bottom-0 left-0 h-0.5 w-5 bg-bone transition"></span>
        </span>
      </button>
    </div>
  </div>
</header>

<!-- Fuera del <header>: su backdrop-filter haría de bloque contenedor y el menú fixed quedaría recortado -->
<div id="mobile-menu" hidden class="fixed inset-x-0 top-18 bottom-0 z-[45] overflow-y-auto overscroll-contain bg-ink sm:top-20 lg:hidden">
  <nav aria-label="Móvil" class="container-x flex min-h-full flex-col justify-between gap-10 pt-6 pb-10">
    <ul class="space-y-1">
      {
        [{ label: 'Inicio', href: '/' }, ...site.nav, { label: 'Contacto', href: '/contacto' }].map((item, i) => (
          <li class="overflow-hidden">
            <a
              href={url(item.href)}
              style={`--i:${i}`}
              class="menu-link display block py-2 text-5xl text-bone transition hover:text-brand"
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
    <div class="space-y-2 text-sm text-mute">
      <a href={`mailto:${site.contact.email}`} class="block hover:text-brand">{site.contact.email}</a>
      <a href={`tel:${site.contact.phone.replace(/\s/g, '')}`} class="block hover:text-brand">{site.contact.phone}</a>
    </div>
  </nav>
</div>

<style>
  #mobile-menu:not([hidden]) .menu-link {
    animation: rise 0.6s cubic-bezier(0.2, 0.8, 0.2, 1) both;
    animation-delay: calc(var(--i) * 60ms);
  }
  [aria-expanded='true'] .bar:first-child {
    transform: translateY(5px) rotate(45deg);
  }
  [aria-expanded='true'] .bar:last-child {
    transform: translateY(-5px) rotate(-45deg);
  }
</style>

<script>
  const header = document.getElementById('site-header')!;
  const toggle = document.getElementById('menu-toggle')!;
  const menu = document.getElementById('mobile-menu')!;

  const onScroll = () => header.setAttribute('data-scrolled', String(window.scrollY > 24 || !menu.hidden));
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  const setOpen = (open: boolean) => {
    menu.hidden = !open;
    header.setAttribute('data-menu', String(open));
    toggle.setAttribute('aria-expanded', String(open));
    document.body.style.overflow = open ? 'hidden' : '';
    onScroll();
  };
  toggle.addEventListener('click', () => setOpen(menu.hidden));
  document.addEventListener('keydown', (e) => e.key === 'Escape' && setOpen(false));
  window.matchMedia('(min-width: 1024px)').addEventListener('change', (e) => e.matches && setOpen(false));
</script>
